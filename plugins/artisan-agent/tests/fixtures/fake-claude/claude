#!/usr/bin/env bash
# A stand-in for `claude -p --output-format json`, for the runner's tests.
# Put this folder first on PATH. FAKE_CLAUDE_MODE picks the behaviour:
#
#   complete    writes $ARTISAN_RESULT_FILE, ends with the completion line, exit 0
#   no-marker   writes $ARTISAN_RESULT_FILE, but no completion line, exit 0
#   blocked     a run stopped by a UserPromptExpansion hook: 0 turns, exit 0,
#               is_error false (the shape research ticket #38 observed)
#   budget      hit --max-budget-usd: subtype error_max_budget_usd, exit 1
#   turns       hit --max-turns: subtype error_max_turns, exit 1
#   api-error   is_error true with subtype success (seen live when not logged in)
#   nonzero     prints nothing, exits 3
#   crash       kills itself with SIGSEGV, writing nothing
#   script      runs the bash file in FAKE_CLAUDE_SCRIPT_ORCHESTRATOR,
#               FAKE_CLAUDE_SCRIPT_VERIFIER or FAKE_CLAUDE_SCRIPT_WORKER (by
#               $ARTISAN_ROLE) in its working
#               directory; completes if the file exits 0, else ends without
#               the completion line
#   stream      like complete, but as `--output-format stream-json --verbose`
#               prints: a system event, a rate_limit_event (the shape seen live:
#               one window, utilization a fraction, resetsAt: in 2100, so the
#               reading never goes stale), then FAKE_CLAUDE_SLEEP
#               seconds later (default 2) a second one for the other window, then
#               the result event
#               A line that is not JSON sits between them, as a stream cut
#               mid-write would leave one.
#   sleep       leaves a stray background `sleep` (argv names the working
#               folder: fake-claude-stray:<folder>) in its process group, sleeps
#               FAKE_CLAUDE_SLEEP seconds (default 30), then completes
#
# Like the real claude, it writes "type" after other keys in its result and
# rate_limit_event lines ({"duration_api_ms":…,"session_id":…,"type":"result",…}),
# so nothing may find an event by the start of its line. FAKE_CLAUDE_TYPE_FIRST=1
# writes "type" first instead, the order older versions used.
#
# It records its arguments, one "[arg]" per line, to $FAKE_CLAUDE_ARGS, its
# working directory and environment of interest to $FAKE_CLAUDE_ENV, and its
# PID to $FAKE_CLAUDE_PID, when those are set.

[ -n "${FAKE_CLAUDE_PID:-}" ] && echo $$ >"$FAKE_CLAUDE_PID"
[ -n "${FAKE_CLAUDE_ARGS:-}" ] && printf '[%s]\n' "$@" >"$FAKE_CLAUDE_ARGS"
if [ -n "${FAKE_CLAUDE_ENV:-}" ]; then
  {
    echo "PWD=$PWD"
    echo "ARTISAN_RESULT_FILE=${ARTISAN_RESULT_FILE:-}"
    echo "ARTISAN_FINDINGS_FILE=${ARTISAN_FINDINGS_FILE:-}"
    echo "ARTISAN_ROLE=${ARTISAN_ROLE:-}"
    echo "ARTISAN_WRITER_PID=${ARTISAN_WRITER_PID:-}"
    echo "ARTISAN_RUN_DIR=${ARTISAN_RUN_DIR:-}"
  } >"$FAKE_CLAUDE_ENV"
fi

result() { # subtype is_error num_turns text
  local text=
  text=$(printf '%s' "$4" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s%s", (NR > 1 ? "\\n" : ""), $0}')
  if [ -n "${FAKE_CLAUDE_TYPE_FIRST:-}" ]; then
    printf '{"type":"result","subtype":"%s","is_error":%s,"num_turns":%s,"total_cost_usd":0.01,"result":"%s"}\n' \
      "$1" "$2" "$3" "$text"
  else
    printf '{"duration_api_ms":1200,"stop_reason":"end_turn","session_id":"s1","total_cost_usd":0.01,"is_error":%s,"num_turns":%s,"subtype":"%s","result":"%s","type":"result","duration_ms":1500}\n' \
      "$2" "$3" "$1" "$text"
  fi
}

rate_limit() { # window utilization resetsAt
  local info=
  info=$(printf '"rate_limit_info":{"status":"allowed","resetsAt":%s,"rateLimitType":"%s","unifiedWindows":{"%s":{"utilization":%s,"resetsAt":%s,"status":"allowed"}}}' \
    "$3" "$1" "$1" "$2" "$3")
  if [ -n "${FAKE_CLAUDE_TYPE_FIRST:-}" ]; then
    printf '{"type":"rate_limit_event",%s,"session_id":"s1"}\n' "$info"
  else
    printf '{%s,"uuid":"u1","session_id":"s1","type":"rate_limit_event"}\n' "$info"
  fi
}

write_result_file() { echo '{"criteria":[]}' >"$ARTISAN_RESULT_FILE"; }

case "${FAKE_CLAUDE_MODE:-complete}" in
  complete)
    write_result_file
    result success false 4 "Built the ticket.

ARTISAN-WORKER: complete"
    ;;
  no-marker)
    write_result_file
    result success false 4 "Built the ticket."
    ;;
  blocked)
    result success false 0 "UserPromptExpansion operation blocked by hook: use /artisan-agent:grill instead"
    ;;
  budget)
    result error_max_budget_usd true 9 ""
    exit 1
    ;;
  turns)
    result error_max_turns true 40 ""
    exit 1
    ;;
  api-error)
    result success true 1 "Not logged in · Please run /login"
    exit 1
    ;;
  nonzero)
    echo "fake claude: boom" >&2
    exit 3
    ;;
  crash)
    kill -SEGV $$
    ;;
  script)
    case "${ARTISAN_ROLE:-worker}" in
      orchestrator) script=${FAKE_CLAUDE_SCRIPT_ORCHESTRATOR:-} ;;
      verifier) script=${FAKE_CLAUDE_SCRIPT_VERIFIER:-} ;;
      *) script=${FAKE_CLAUDE_SCRIPT_WORKER:-} ;;
    esac
    if [ -n "$script" ] && bash "$script" >>"${FAKE_CLAUDE_LOG:-/dev/null}" 2>&1; then
      result success false 6 "Ran the script.

ARTISAN-WORKER: complete"
    else
      result success false 6 "The script failed."
    fi
    ;;
  stream)
    echo '{"type":"system","subtype":"init","session_id":"s1"}'
    rate_limit seven_day 0.29 4102444800
    sleep "${FAKE_CLAUDE_SLEEP:-2}"
    echo '{"session_id":"s1","type":"result","result":"cut off'
    rate_limit five_hour 0.5 4102444000
    write_result_file
    result success false 4 "Built the ticket.

ARTISAN-WORKER: complete"
    ;;
  sleep)
    # Named for the test's folder (argv "$0"), so tests/run.sh's cleanup, which
    # ends what names the folder, finds it (#145). The `; :` keeps sh from
    # exec'ing straight into sleep, which would drop the name. Still in this
    # process group.
    sh -c 'sleep 300; :' "fake-claude-stray:$PWD" &
    sleep "${FAKE_CLAUDE_SLEEP:-30}"
    write_result_file
    result success false 4 "Slept.

ARTISAN-WORKER: complete"
    ;;
esac
