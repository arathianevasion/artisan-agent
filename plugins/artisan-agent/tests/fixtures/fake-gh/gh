#!/usr/bin/env bash
# A stand-in for `gh`, backed by a local folder tracker, so no test or trial
# ever touches GitHub. Put this folder first on PATH and set FAKE_GH_DIR.
#
# The tracker, in $FAKE_GH_DIR:
#   issue-<n>.json        {"number", "title", "body", "state": "open"|"closed", "labels": [{"name"}]}
#   blocked_by-<n>.json   [<number>, ...] the issues blocking <n> (state read live)
#   comments-<n>.md       comments, appended, separated by "---"; the k-th (from 1) has
#                         the node id IC_<n>_<k>, as --json comments shows it
#   calls                 every call, one per line
#
# Answers:
#   gh api repos/<o>/<r>/issues/<n>
#   gh api repos/<o>/<r>/issues/<n>/dependencies/blocked_by
#   gh issue view <n> [-R repo] [--json fields] [-q|--jq filter] [--comments]
#   gh issue list [-R repo] [--state open|closed|all] [--label L]... [--limit N] [--json fields] [-q filter]
#                         newest first, only issues with every --label, at most N (default 30),
#                         as real gh does (an empty tracker lists [] and exits 0)
#   gh issue comment <n> [-R repo] (--body|-b TEXT | --body-file|-F FILE)
#   gh api graphql --input FILE|-   the updateIssueComment mutation only: {query, variables:
#                         {id, body}} replaces the comment with that node id (IC_<n>_<k>)
#   gh issue edit <n> [-R repo] (--body|-b TEXT | --body-file|-F FILE)
#   gh issue close <n> [-R repo] [--comment|-c TEXT]
#   gh issue create [-R repo] --title T (--body|-b B | --body-file|-F FILE) [--label L]...
#                         prints the new issue's URL; numbers continue after the highest issue;
#                         id is 1000 + number
#   An issue or comment body over 65,536 characters fails, as on GitHub (FILE - is stdin);
#   with the file comments-fail, every issue comment fails.
#   gh api repos/<o>/<r>/issues/<n>/sub_issues                    the plan's sub-issues (sub_issues-<n>.json,
#                         a list of numbers); POST --method with -F sub_issue_id=<id> adds one, failing
#                         like GitHub when the child already has a parent (parent-<child>) unless
#                         -F replace_parent=true
#   gh api repos/<o>/<r>/issues/<n>/parent    the issue its parent-<n> file names, else HTTP 404
#   gh api --method POST repos/<o>/<r>/issues/<n>/dependencies/blocked_by -F issue_id=<id>
#   gh api --method DELETE repos/<o>/<r>/issues/<n>/dependencies/blocked_by/<id>
#   gh issue edit <n> --add-label L / --remove-label L (also with a body)
#   gh pr create [-R repo] --base B --head H --title T (--body B | --body-file F)
#                         records pr-<n>.json {number, base, head, title, body}; prints its URL
#   gh pr view <n|url> [-R repo] --json state,mergeCommit [-q filter]
#                         from pr-<n>.json: state (OPEN unless the file says otherwise) and
#                         mergeCommit {oid}; a test merges a PR by setting state and merge_oid
#   gh workflow run <file> [-R repo] --ref <branch> [-f key=value]...
#                         starts a workflow_dispatch run (run-<id>.json, ids from 9001) on the
#                         branch's tip in the git repo FAKE_GH_REMOTE (a path; the branch must exist
#                         there). How it goes, from files the test writes in $FAKE_GH_DIR:
#                           ci-outcome      success (default) | any other conclusion (failure, cancelled, ...) | never (stays in_progress)
#                           ci-red-if-file  a path: a commit whose tree has it concludes failure (wins over ci-outcome)
#                           ci-red-outcome  the conclusion ci-red-if-file gives instead of failure (timed_out, ...)
#                           ci-sha          a head SHA to report instead of the branch's tip
#                           ci-jobs         the jobs, a JSON list of names (default ["bash 5.2", "bash 3.2"])
#                           ci-unavailable  present: the dispatch fails, as with GitHub down
#                           ci-no-runner    a JSON list of job names no runner picks up (#258): each is
#                                           cancelled with GitHub's "not acquired by Runner" annotation
#                                           and the run concludes failure, though every job that ran passed
#                           ci-no-runner-attempts  how many attempts the shortage lasts (default: all)
#                           ci-no-runner-runs      how many dispatched runs it hits, from the first (default: all)
#                         Each job has a databaseId (its check run's id): the run's id x 100 + its place.
#                         Each -f input is kept on the run as inputs {key: value} (the fake's own
#                         field; real gh shows inputs only in the run's web page).
#                         The run's displayTitle is the workflow's run-name, from files the test writes:
#                           ci-run-name        a template; each ${{ inputs.K }} becomes K's -f value, else
#                                              its default (default: the workflow name, as GitHub does)
#                           ci-input-defaults  a JSON object, the defaults of the workflow's inputs
#   gh run list [-R repo] [--workflow F] [--branch B] [--event E] [--limit N] [--json fields] [-q filter]
#                         the run-<id>.json files, newest first: databaseId, workflowName, headBranch,
#                         headSha, event, status, conclusion, url, createdAt, updatedAt
#   gh run view <id> [-R repo] [--json fields] [-q filter]
#                         one run, with jobs [{databaseId, name, status, conclusion}]
#   gh run view <id> [-R repo] --log-failed
#                         the failed jobs' log ("<job>\t<step>\t<timestamp> <line>"): the file
#                         ci-log-failed-<id>, else ci-log-failed, the test writes in $FAKE_GH_DIR;
#                         with neither, it fails
#   gh run rerun <id> [-R repo] [--failed]
#                         a new attempt of the run (attempt + 1, as GitHub numbers them), concluded
#                         at once: the file ci-rerun-outcome if the test wrote one, else as the
#                         dispatch decides for the run's head SHA (so a real failure stays red).
#                         --failed reruns only the jobs that did not pass; a job no runner picks
#                         up is cancelled again while ci-no-runner-attempts lasts
#   gh api repos/<repo>/check-runs/<job id>/annotations
#                         the job's annotations: GitHub's "not acquired by Runner" one for a job
#                         ci-no-runner cancelled, else []; 404 for a job no run has
#   gh project view|field-list|item-list <n> --owner O --format json
#   gh project item-add <n> --owner O --url <issue url> --format json
#   gh project item-edit --id I --project-id P --field-id F (--single-select-option-id O | --text T | --number N | --date D)
#                         a board in project-<owner>-<n>.json the test writes (its shape is at the
#                         handler); the file project-unavailable fails them all, like a missing scope
# Anything else fails with exit 1. Needs jq (and git, for workflow run).

set -euo pipefail
: "${FAKE_GH_DIR:?set FAKE_GH_DIR to the fake tracker folder}"
printf '%s\n' "$*" >>"$FAKE_GH_DIR/calls"

issue_file() { printf '%s/issue-%s.json\n' "$FAKE_GH_DIR" "$1"; }
need_issue() { [ -f "$(issue_file "$1")" ] || { echo "gh: issue #$1 not found (HTTP 404)" >&2; exit 1; }; }
set_field() { # n jq-filter [args]
  local f= n=$1
  f=$(issue_file "$n")
  shift
  jq "$@" "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# A repo must look like owner/name, as on GitHub.
bad_repo() { echo "gh: expected the \"[HOST/]OWNER/REPO\" format, got \"$1\"" >&2; exit 1; }
check_repo() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || bad_repo "$1"; }

# GitHub refuses an issue or comment body over 65,536 characters.
check_body() { # body
  [ "$(printf '%s' "$1" | jq -n --rawfile b /dev/stdin '$b | length')" -le 65536 ] \
    || { echo "GraphQL: Body is too long (maximum is 65536 characters)" >&2; exit 1; }
}

# Common flags after the subcommand: -R, --json, -q/--jq, bodies, --label, --limit.
n= json= filter= body= body_set= comments= state=open limit=30 labels_wanted='[]'
parse() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -R|--repo) check_repo "$2"; shift 2 ;;
      --json) json=$2; shift 2 ;;
      -q|--jq) filter=$2; shift 2 ;;
      --body|-b|--comment|-c) body=$2; body_set=1; shift 2 ;;
      --body-file|-F) body=$(cat "$2"); body_set=1; shift 2 ;;
      --comments) comments=1; shift ;;
      --state|-s) state=$2; shift 2 ;;
      --label|-l) labels_wanted=$(printf '%s' "$labels_wanted" | jq -c --arg l "$2" '. + [$l]'); shift 2 ;;
      --limit|-L) limit=$2; shift 2 ;;
      --*) shift ;;
      *) [ -n "$n" ] || n=${1#\#}; shift ;;
    esac
  done
}

emit() { # json-object-or-array
  if [ -n "$filter" ]; then printf '%s' "$1" | jq -r "$filter"; else printf '%s\n' "$1"; fi
}

# outcome_for sha: how a run of that commit concludes (ci-outcome, ci-red-if-file).
outcome_for() {
  local o=success
  [ ! -s "$FAKE_GH_DIR/ci-outcome" ] || o=$(cat "$FAKE_GH_DIR/ci-outcome")
  if [ -s "$FAKE_GH_DIR/ci-red-if-file" ] && git -C "${FAKE_GH_REMOTE:-.}" cat-file -e "$1:$(cat "$FAKE_GH_DIR/ci-red-if-file")" 2>/dev/null; then
    o=failure
    [ ! -s "$FAKE_GH_DIR/ci-red-outcome" ] || o=$(cat "$FAKE_GH_DIR/ci-red-outcome")
  fi
  printf '%s\n' "$o"
}

# The jobs no runner picks up for run ID at attempt N (ci-no-runner, while
# ci-no-runner-attempts and ci-no-runner-runs last), as a JSON list; [] when
# runners are there.
no_runner_jobs() { # id attempt
  local n="" r=""
  [ -s "$FAKE_GH_DIR/ci-no-runner" ] || { echo '[]'; return 0; }
  [ ! -s "$FAKE_GH_DIR/ci-no-runner-attempts" ] || n=$(cat "$FAKE_GH_DIR/ci-no-runner-attempts")
  [ ! -s "$FAKE_GH_DIR/ci-no-runner-runs" ] || r=$(cat "$FAKE_GH_DIR/ci-no-runner-runs")
  if [ -n "$n" ] && [ "$2" -gt "$n" ]; then echo '[]'; return 0; fi
  if [ -n "$r" ] && [ "$1" -gt $((9000 + r)) ]; then echo '[]'; return 0; fi
  cat "$FAKE_GH_DIR/ci-no-runner"
}
NO_RUNNER_MESSAGE="The job was not acquired by Runner of type hosted even after multiple attempts"

api_method=GET api_fields= api_input=
if [ "${1:-}" = api ]; then
  shift
  api_args=("$@")
  path=
  while [ $# -gt 0 ]; do
    case "$1" in
      --method|-X) api_method=$2; shift 2 ;;
      -F|-f|--field|--raw-field) api_fields="$api_fields $2"; shift 2 ;;
      --input) api_input=$2; shift 2 ;;
      -*) shift ;;
      *) path=$1; shift ;;
    esac
  done
  set -- api "$path"
fi

case "${1:-} ${2:-}" in
  "api "*)
    path=$2
    if [ "$path" = graphql ]; then
      req=$( [ "$api_input" = - ] && cat || cat "$api_input" )
      printf '%s' "$req" | jq -e '.query | test("updateIssueComment")' >/dev/null 2>&1 \
        || { echo "gh (fake): unsupported graphql query" >&2; exit 1; }
      cid=$(printf '%s' "$req" | jq -r '.variables.id // ""')
      n=${cid#IC_}; k=${n#*_}; n=${n%%_*}
      c="$FAKE_GH_DIR/comments-$n.md"
      if ! printf '%s' "$cid" | grep -Eq '^IC_[0-9]+_[0-9]+$' || [ ! -f "$c" ] \
        || [ "$(jq -Rs --argjson k "$k" 'split("\n---\n") | length >= $k' "$c")" != true ]; then
        echo "gh: Could not resolve to a node with the global id of '$cid'" >&2; exit 1
      fi
      jq -Rsj --argjson k "$k" --arg b "$(printf '%s' "$req" | jq -r .variables.body)" \
        'split("\n---\n") | .[$k - 1] = $b | join("\n---\n")' "$c" >"$c.tmp" && mv "$c.tmp" "$c"
      jq -cn --arg id "$cid" '{data: {updateIssueComment: {issueComment: {id: $id}}}}'
      exit 0
    fi
    if [ "$api_method" = DELETE ]; then
      case "$path" in
        */dependencies/blocked_by/*)
          n=${path%/dependencies/blocked_by/*}; n=${n##*/}
          need_issue "$n"
          blocker=
          for f in "$FAKE_GH_DIR"/issue-*.json; do
            [ -f "$f" ] || continue
            b=$(jq -r --argjson id "${path##*/}" 'select((.id // (1000 + .number)) == $id) | .number' "$f")
            [ -z "$b" ] || blocker=$b
          done
          [ -n "$blocker" ] || { echo "gh: blocking issue not found (HTTP 404)" >&2; exit 1; }
          cur='[]'; [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
          printf '%s' "$cur" | jq -c --argjson b "$blocker" 'map(select(. != $b))' >"$FAKE_GH_DIR/blocked_by-$n.json"
          echo '{}' ;;
        *) echo "gh: unsupported api DELETE path: $path" >&2; exit 1 ;;
      esac
      exit 0
    fi
    if [ "$api_method" = POST ]; then
      field() { for kv in $api_fields; do case "$kv" in "$1="*) printf '%s' "${kv#*=}" ;; esac; done; }
      n=${path#repos/*/issues/}; n=${n%%/*}
      need_issue "$n"
      by_id() { for f in "$FAKE_GH_DIR"/issue-*.json; do [ -f "$f" ] && jq -r --argjson id "$1" 'select((.id // (1000 + .number)) == $id) | .number' "$f"; done; }
      case "$path" in
        */sub_issues)
          child=$(by_id "$(field sub_issue_id)")
          [ -n "$child" ] || { echo "gh: sub-issue not found (HTTP 404)" >&2; exit 1; }
          if [ -f "$FAKE_GH_DIR/parent-$child" ] && [ "$(field replace_parent)" != true ]; then
            echo "gh: Parent issue already exists for this sub-issue (HTTP 422)" >&2; exit 1
          fi
          old=$(cat "$FAKE_GH_DIR/parent-$child" 2>/dev/null || true)
          if [ -n "$old" ] && [ -f "$FAKE_GH_DIR/sub_issues-$old.json" ]; then
            jq -c --argjson c "$child" 'map(select(. != $c))' "$FAKE_GH_DIR/sub_issues-$old.json" >"$FAKE_GH_DIR/s.tmp" \
              && mv "$FAKE_GH_DIR/s.tmp" "$FAKE_GH_DIR/sub_issues-$old.json"
          fi
          cur='[]'; [ -f "$FAKE_GH_DIR/sub_issues-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/sub_issues-$n.json")
          printf '%s' "$cur" | jq -c --argjson c "$child" '. + [$c]' >"$FAKE_GH_DIR/sub_issues-$n.json"
          printf '%s' "$n" >"$FAKE_GH_DIR/parent-$child"
          echo '{}' ;;
        */dependencies/blocked_by)
          blocker=$(by_id "$(field issue_id)")
          [ -n "$blocker" ] || { echo "gh: blocking issue not found (HTTP 404)" >&2; exit 1; }
          cur='[]'; [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
          printf '%s' "$cur" | jq -e --argjson b "$blocker" 'index($b)' >/dev/null 2>&1 \
            && { echo "gh: already blocked (HTTP 422)" >&2; exit 1; }
          printf '%s' "$cur" | jq -c --argjson b "$blocker" '. + [$b]' >"$FAKE_GH_DIR/blocked_by-$n.json"
          echo '{}' ;;
        *) echo "gh: unsupported api POST path: $path" >&2; exit 1 ;;
      esac
      exit 0
    fi
    r=${path#repos/}; r=${r%%/issues/*}
    case "$path" in repos/*/issues/*) check_repo "$r" ;; esac
    case "$path" in
      repos/*/check-runs/*/annotations)
        check_repo "${r%%/check-runs/*}"
        jid=${path%/annotations}; jid=${jid##*/}
        job=$(for f in "$FAKE_GH_DIR"/run-*.json; do [ -f "$f" ] || continue
          jq -c --arg j "$jid" '.jobs[]? | select((.databaseId | tostring) == $j)' "$f"; done | head -n 1)
        [ -n "$job" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        jq -c --arg m "$NO_RUNNER_MESSAGE" 'if .no_runner then [{path: ".github", start_line: 1, end_line: 1,
            annotation_level: "failure", title: "", message: $m}] else [] end' <<<"$job" ;;
      repos/*/issues/*/sub_issues)
        n=${path%/sub_issues}; n=${n##*/}
        need_issue "$n"
        list='[]'
        [ -f "$FAKE_GH_DIR/sub_issues-$n.json" ] && list=$(cat "$FAKE_GH_DIR/sub_issues-$n.json")
        for b in $(printf '%s' "$list" | jq -r '.[]'); do jq -c '{number, title, state, labels}' "$(issue_file "$b")"; done | jq -s . ;;
      repos/*/issues/*/parent)
        n=${path%/parent}; n=${n##*/}
        need_issue "$n"
        [ -f "$FAKE_GH_DIR/parent-$n" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        jq '. + {id: (.id // (1000 + .number))}' "$(issue_file "$(cat "$FAKE_GH_DIR/parent-$n")")" ;;
      repos/*/issues/*/dependencies/blocked_by)
        n=${path%/dependencies/blocked_by}; n=${n##*/}
        need_issue "$n"
        list='[]'
        [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && list=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
        for b in $(printf '%s' "$list" | jq -r '.[]'); do
          if [ -f "$(issue_file "$b")" ]; then jq -c '{number, title, state}' "$(issue_file "$b")"
          else jq -cn --argjson b "$b" '{number: $b, state: "open"}'; fi
        done | jq -s . ;;
      repos/*/issues/*)
        n=${path##*/}
        need_issue "$n"
        jq '. + {id: (.id // (1000 + .number))}' "$(issue_file "$n")" ;;
      *) echo "gh: unsupported api path: $path" >&2; exit 1 ;;
    esac ;;
  "issue view")
    shift 2; parse "$@"; need_issue "$n"
    f=$(issue_file "$n")
    if [ -n "$json" ]; then
      emit "$(jq -c --arg fields "$json" --arg c "$(cat "$FAKE_GH_DIR/comments-$n.md" 2>/dev/null || true)" '
        . as $i | . + {comments: (if $c == "" then [] else [$c | split("\n---\n") | to_entries[]
          | {id: "IC_\($i.number)_\(.key + 1)", body: .value}] end)}
        | with_entries(select(.key as $k | $fields | split(",") | index($k)))' "$f")"
    else
      jq -r '"title:\t\(.title)\nstate:\t\(.state | ascii_upcase)\nnumber:\t\(.number)\n--\n\(.body)"' "$f"
      if [ -n "$comments" ] && [ -f "$FAKE_GH_DIR/comments-$n.md" ]; then
        printf -- '--\n'; cat "$FAKE_GH_DIR/comments-$n.md"
      fi
    fi ;;
  "issue list")
    shift 2; parse "$@"
    # A glob that matches nothing leaves the literal pattern: skip it, so an empty tracker lists [].
    all=$(for f in "$FAKE_GH_DIR"/issue-*.json; do [ -f "$f" ] || continue; cat "$f"; done \
      | jq -s --arg s "$state" --argjson want "$labels_wanted" --argjson limit "$limit" '
          map(select(($s == "all" or .state == $s)
                     and ([(.labels // [])[].name] as $have | all($want[]; . as $l | $have | index($l)))))
          | sort_by(-.number) | .[:$limit]')
    if [ -n "$json" ]; then emit "$all"
    else printf '%s' "$all" | jq -r '.[] | "\(.number)\t\(.state | ascii_upcase)\t\(.title)"'; fi ;;
  "issue create")
    shift 2
    title= body= labels='[]'
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --title|-t) title=$2; shift 2 ;;
        --body|-b) body=$2; shift 2 ;;
        --body-file|-F) body=$(cat "$2"); shift 2 ;;
        --label|-l) labels=$(printf '%s' "$labels" | jq -c --arg l "$2" '. + [{name: $l}]'); shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$title" ] || { echo "gh: a title is required" >&2; exit 1; }
    check_body "$body"
    last=0
    for f in "$FAKE_GH_DIR"/issue-*.json; do
      [ -f "$f" ] || continue
      k=$(jq -r .number "$f"); [ "$k" -le "$last" ] || last=$k
    done
    num=$((last + 1))
    jq -n --argjson n "$num" --arg t "$title" --arg b "$body" --argjson l "$labels" \
      '{number: $n, id: (1000 + $n), title: $t, body: $b, state: "open", labels: $l}' >"$(issue_file "$num")"
    echo "https://github.com/${FAKE_GH_REPO:-local/sample}/issues/$num" ;;
  "issue comment")
    shift 2; parse "$@"; need_issue "$n"
    [ -n "$body_set" ] || { echo "gh: a comment needs --body or --body-file" >&2; exit 1; }
    [ ! -e "$FAKE_GH_DIR/comments-fail" ] || { echo "gh: HTTP 502: Server Error" >&2; exit 1; }
    check_body "$body"
    c="$FAKE_GH_DIR/comments-$n.md"
    [ ! -s "$c" ] || printf '\n---\n' >>"$c"
    printf '%s' "$body" >>"$c" ;;
  "issue edit")
    shift 2; parse "$@"; need_issue "$n"
    [ -z "$body_set" ] || { check_body "$body"; set_field "$n" --arg b "$body" '.body = $b'; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --add-label) set_field "$n" --arg l "$2" '.labels = ((.labels // []) | map(select(.name != $l)) + [{name: $l}])'; shift 2 ;;
        --remove-label) set_field "$n" --arg l "$2" '.labels = ((.labels // []) | map(select(.name != $l)))'; shift 2 ;;
        *) shift ;;
      esac
    done ;;
  "issue close")
    shift 2; parse "$@"; need_issue "$n"
    if [ -n "$body_set" ]; then
      c="$FAKE_GH_DIR/comments-$n.md"
      [ ! -s "$c" ] || printf '\n---\n' >>"$c"
      printf '%s' "$body" >>"$c"
    fi
    set_field "$n" '.state = "closed"' ;;
  "pr create")
    shift 2
    base= head= title= body=
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --base|-B) base=$2; shift 2 ;;
        --head|-H) head=$2; shift 2 ;;
        --title|-t) title=$2; shift 2 ;;
        --body|-b) body=$2; shift 2 ;;
        --body-file|-F) body=$(cat "$2"); shift 2 ;;
        *) echo "gh (fake): pr create: unsupported: $1" >&2; exit 1 ;;
      esac
    done
    [ -n "$base" ] && [ -n "$head" ] && [ -n "$title" ] || { echo "gh: pr create needs --base, --head and --title" >&2; exit 1; }
    num=1
    while [ -f "$FAKE_GH_DIR/pr-$num.json" ]; do num=$((num + 1)); done
    jq -n --argjson n "$num" --arg b "$base" --arg h "$head" --arg t "$title" --arg body "$body" \
      '{number: $n, base: $b, head: $h, title: $t, body: $body}' >"$FAKE_GH_DIR/pr-$num.json"
    echo "https://github.com/${FAKE_GH_REPO:-local/sample}/pull/$num" ;;
  "pr view")
    shift 2
    n= filter=
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --json) shift 2 ;;
        -q|--jq) filter=$2; shift 2 ;;
        *) n=${1##*/}; shift ;;
      esac
    done
    [ -f "$FAKE_GH_DIR/pr-$n.json" ] || { echo "gh: no pull request #$n (HTTP 404)" >&2; exit 1; }
    out=$(jq -c '{state: (.state // "OPEN"), mergeCommit: (if .merge_oid then {oid: .merge_oid} else null end)}' "$FAKE_GH_DIR/pr-$n.json")
    if [ -n "$filter" ]; then printf '%s' "$out" | jq -r "$filter"; else printf '%s\n' "$out"; fi ;;
  "workflow run")
    shift 2
    wf= ref= inputs='{}'
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --ref|-r) ref=$2; shift 2 ;;
        -f|--raw-field) inputs=$(jq -c --arg k "${2%%=*}" --arg v "${2#*=}" '. + {($k): $v}' <<<"$inputs"); shift 2 ;;
        -*) echo "gh (fake): workflow run: unsupported: $1" >&2; exit 1 ;;
        *) wf=$1; shift ;;
      esac
    done
    [ -n "$wf" ] && [ -n "$ref" ] || { echo "gh: workflow run needs a workflow and --ref" >&2; exit 1; }
    [ ! -e "$FAKE_GH_DIR/ci-unavailable" ] || { echo "gh: HTTP 503: Service Unavailable" >&2; exit 1; }
    : "${FAKE_GH_REMOTE:?set FAKE_GH_REMOTE to the git repo CI runs from}"
    sha=$(git -C "$FAKE_GH_REMOTE" rev-parse -q --verify "refs/heads/$ref^{commit}") \
      || { echo "gh: could not find ref $ref (HTTP 422)" >&2; exit 1; }
    [ ! -s "$FAKE_GH_DIR/ci-sha" ] || sha=$(cat "$FAKE_GH_DIR/ci-sha")
    outcome=$(outcome_for "$sha")
    jobs='["bash 5.2", "bash 3.2"]'
    [ ! -s "$FAKE_GH_DIR/ci-jobs" ] || jobs=$(cat "$FAKE_GH_DIR/ci-jobs")
    title=$wf
    if [ -f "$FAKE_GH_DIR/ci-run-name" ]; then
      defaults='{}'
      [ ! -s "$FAKE_GH_DIR/ci-input-defaults" ] || defaults=$(cat "$FAKE_GH_DIR/ci-input-defaults")
      title=$(jq -rn --arg t "$(cat "$FAKE_GH_DIR/ci-run-name")" --argjson d "$defaults" --argjson in "$inputs" '
        ($d + $in) as $v | $t | gsub("\\$\\{\\{ *inputs\\.(?<k>[A-Za-z0-9_-]+) *\\}\\}"; (.k as $k | if ($v | has($k)) then ($v[$k] | tostring) else "" end))')
    fi
    id=9001
    while [ -f "$FAKE_GH_DIR/run-$id.json" ]; do id=$((id + 1)); done
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    jq -n --argjson id "$id" --arg wf "$wf" --arg b "$ref" --arg sha "$sha" --arg o "$outcome" --argjson jobs "$jobs" \
      --arg now "$now" --arg repo "${FAKE_GH_REPO:-local/sample}" --argjson in "$inputs" --arg title "$title" \
      --argjson nr "$(no_runner_jobs "$id" 1)" '
      (if $o == "never" then {status: "in_progress", conclusion: null} else {status: "completed", conclusion: $o} end) as $s
      | [$jobs | to_entries[] | {databaseId: ($id * 100 + .key + 1), name: .value}
          + (if (.value | IN($nr[])) then {status: "completed", conclusion: "cancelled", no_runner: true}
             else {status: $s.status, conclusion: $s.conclusion} end)] as $j
      | {databaseId: $id, attempt: 1, workflowName: $wf, displayTitle: $title, headBranch: $b, headSha: $sha, event: "workflow_dispatch",
         url: "https://github.com/\($repo)/actions/runs/\($id)", createdAt: $now, updatedAt: $now, inputs: $in}
        + $s + (if $s.conclusion == "success" and any($j[]; .no_runner) then {conclusion: "failure"} else {} end)
        + {jobs: $j}' >"$FAKE_GH_DIR/run-$id.json" ;;
  "run list")
    shift 2
    wf= br= ev= limit=20 filter=
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --workflow|-w) wf=$2; shift 2 ;;
        --branch|-b) br=$2; shift 2 ;;
        --event|-e) ev=$2; shift 2 ;;
        --limit|-L) limit=$2; shift 2 ;;
        --json) shift 2 ;;
        -q|--jq) filter=$2; shift 2 ;;
        *) echo "gh (fake): run list: unsupported: $1" >&2; exit 1 ;;
      esac
    done
    out=$(for f in "$FAKE_GH_DIR"/run-*.json; do [ -f "$f" ] || continue; cat "$f"; done \
      | jq -sc --arg wf "$wf" --arg br "$br" --arg ev "$ev" --argjson l "$limit" '
          map(select(($wf == "" or .workflowName == $wf) and ($br == "" or .headBranch == $br) and ($ev == "" or .event == $ev)) | del(.jobs))
          | sort_by(.databaseId) | reverse | .[:$l]')
    if [ -n "$filter" ]; then printf '%s' "$out" | jq -r "$filter"; else printf '%s\n' "$out"; fi ;;
  "run view")
    shift 2
    id= filter= logfailed=
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --json) shift 2 ;;
        -q|--jq) filter=$2; shift 2 ;;
        --log-failed) logfailed=1; shift ;;
        -*) echo "gh (fake): run view: unsupported: $1" >&2; exit 1 ;;
        *) id=$1; shift ;;
      esac
    done
    [ -f "$FAKE_GH_DIR/run-$id.json" ] || { echo "gh: run $id not found (HTTP 404)" >&2; exit 1; }
    if [ -n "$logfailed" ]; then
      if [ -f "$FAKE_GH_DIR/ci-log-failed-$id" ]; then cat "$FAKE_GH_DIR/ci-log-failed-$id"; exit 0; fi
      [ -f "$FAKE_GH_DIR/ci-log-failed" ] || { echo "gh: log not found" >&2; exit 1; }
      cat "$FAKE_GH_DIR/ci-log-failed"
      exit 0
    fi
    out=$(jq -c . "$FAKE_GH_DIR/run-$id.json")
    if [ -n "$filter" ]; then printf '%s' "$out" | jq -r "$filter"; else printf '%s\n' "$out"; fi ;;
  "run rerun")
    shift 2
    id= failed=false
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --failed) failed=true; shift ;;
        -*) echo "gh (fake): run rerun: unsupported: $1" >&2; exit 1 ;;
        *) id=$1; shift ;;
      esac
    done
    f="$FAKE_GH_DIR/run-$id.json"
    [ -f "$f" ] || { echo "gh: run $id not found (HTTP 404)" >&2; exit 1; }
    outcome=$(outcome_for "$(jq -r .headSha "$f")")
    [ ! -s "$FAKE_GH_DIR/ci-rerun-outcome" ] || outcome=$(cat "$FAKE_GH_DIR/ci-rerun-outcome")
    jq --arg o "$outcome" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson failed "$failed" \
      --argjson nr "$(no_runner_jobs "$id" "$(( $(jq -r '.attempt // 1' "$f") + 1 ))")" '
      (if $o == "never" then {status: "in_progress", conclusion: null} else {status: "completed", conclusion: $o} end) as $s
      | .attempt = ((.attempt // 1) + 1) | .updatedAt = $now | . + $s
      | .jobs = [.jobs[] | if $failed and .conclusion == "success" then .
          elif (.name | IN($nr[])) then . + {status: "completed", conclusion: "cancelled", no_runner: true}
          else . + {status: $s.status, conclusion: $s.conclusion} | del(.no_runner) end]
      | if .conclusion == "success" and any(.jobs[]; .no_runner) then .conclusion = "failure" else . end' "$f" >"$f.tmp" && mv "$f.tmp" "$f" ;;
  "project "*)
    # A GitHub Project board (#146): project-<owner>-<number>.json, which the
    # test writes: {id, fields: [{id, name, type, options?: [{id, name}]}],
    # items: [{id, content: {type, number, repository, url}, values: {<field
    # name>: value}}]}. The file project-unavailable fails every call, as a
    # token without the project scope does.
    sub=${2:-}
    shift 2
    if [ -e "$FAKE_GH_DIR/project-unavailable" ]; then
      echo "gh: your authentication token is missing required scopes [project]" >&2; exit 1
    fi
    pnum= powner= purl= fmt= iid= pid= fid= text= numv= opt=
    while [ $# -gt 0 ]; do
      case "$1" in
        --owner) powner=$2; shift 2 ;;
        --url) purl=$2; shift 2 ;;
        --format) fmt=$2; shift 2 ;;
        --id) iid=$2; shift 2 ;;
        --project-id) pid=$2; shift 2 ;;
        --field-id) fid=$2; shift 2 ;;
        --text) text=$2; shift 2 ;;
        --number) numv=$2; shift 2 ;;
        --date) text=$2; shift 2 ;;
        --single-select-option-id) opt=$2; shift 2 ;;
        -L|--limit) shift 2 ;;
        -*) echo "gh (fake): project $sub: unsupported: $1" >&2; exit 1 ;;
        *) pnum=$1; shift ;;
      esac
    done
    if [ "$sub" = item-edit ]; then
      pf=
      for f in "$FAKE_GH_DIR"/project-*.json; do
        [ -f "$f" ] || continue
        [ "$(jq -r .id "$f")" != "$pid" ] || pf=$f
      done
      [ -n "$pf" ] || { echo "gh: project $pid not found" >&2; exit 1; }
      jq -e --arg i "$iid" 'any(.items[]; .id == $i)' "$pf" >/dev/null || { echo "gh: item $iid not found" >&2; exit 1; }
      fname=$(jq -r --arg f "$fid" '.fields[] | select(.id == $f) | .name' "$pf")
      [ -n "$fname" ] || { echo "gh: field $fid not found" >&2; exit 1; }
      if [ -n "$opt" ]; then
        v=$(jq -c --arg f "$fid" --arg o "$opt" '[.fields[] | select(.id == $f) | .options[]? | select(.id == $o) | .name] | first // empty' "$pf")
        [ -n "$v" ] || { echo "gh: option $opt not found" >&2; exit 1; }
      elif [ -n "$numv" ]; then v=$numv
      else v=$(jq -cn --arg t "$text" '$t'); fi
      jq --arg i "$iid" --arg n "$fname" --argjson v "$v" \
        '.items |= map(if .id == $i then .values = ((.values // {}) + {($n): $v}) else . end)' "$pf" >"$pf.tmp" && mv "$pf.tmp" "$pf"
      exit 0
    fi
    pf="$FAKE_GH_DIR/project-$powner-$pnum.json"
    [ -f "$pf" ] || { echo "gh: project $powner/$pnum not found" >&2; exit 1; }
    [ "$fmt" = json ] || { echo "gh (fake): project $sub: only --format json" >&2; exit 1; }
    case "$sub" in
      view) jq -c '{id, number: '"$pnum"', title: (.title // "Board")}' "$pf" ;;
      field-list) jq -c '{fields: .fields, totalCount: (.fields | length)}' "$pf" ;;
      item-list)
        # As gh prints them: each field value under the field's name in lower case.
        jq -c '{items: [.items[] | {id, content} + ((.values // {}) | with_entries(.key |= ascii_downcase))],
                totalCount: (.items | length)}' "$pf" ;;
      item-add)
        n=${purl##*/}
        r=$(printf '%s' "$purl" | sed -n 's#^https://github.com/\([^/]*/[^/]*\)/issues/[0-9]*$#\1#p')
        [ -n "$r" ] || { echo "gh: not an issue url: $purl" >&2; exit 1; }
        existing=$(jq -r --arg u "$purl" '[.items[] | select(.content.url == $u) | .id] | first // empty' "$pf")
        if [ -z "$existing" ]; then
          existing="PVTI_$(jq '.items | length + 1' "$pf")"
          jq --arg id "$existing" --arg u "$purl" --arg r "$r" --argjson n "$n" \
            '.items += [{id: $id, content: {type: "Issue", number: $n, repository: $r, url: $u}, values: {}}]' "$pf" >"$pf.tmp" \
            && mv "$pf.tmp" "$pf"
        fi
        jq -cn --arg id "$existing" '{id: $id, type: "Issue"}' ;;
      *) echo "gh (fake): unsupported: project $sub" >&2; exit 1 ;;
    esac ;;
  *) echo "gh (fake): unsupported: $*" >&2; exit 1 ;;
esac
