#!/usr/bin/env bash
# A stand-in for `gh`, backed by a local folder tracker, so no test or trial
# ever touches GitHub. Put this folder first on PATH and set FAKE_GH_DIR.
#
# The tracker, in $FAKE_GH_DIR:
#   issue-<n>.json        {"number", "title", "body", "state": "open"|"closed", "labels": [{"name"}]}
#   blocked_by-<n>.json   [<number>, ...] the issues blocking <n> (state read live)
#   comments-<n>.md       comments, appended, separated by "---"
#   calls                 every call, one per line
#
# Answers:
#   gh api repos/<o>/<r>/issues/<n>
#   gh api repos/<o>/<r>/issues/<n>/dependencies/blocked_by
#   gh issue view <n> [-R repo] [--json fields] [-q|--jq filter] [--comments]
#   gh issue list [-R repo] [--state open|closed|all] [--json fields] [-q filter]
#                         (an empty tracker lists [] and exits 0, as real gh does)
#   gh issue comment <n> [-R repo] (--body|-b TEXT | --body-file|-F FILE)
#   gh issue edit <n> [-R repo] (--body|-b TEXT | --body-file|-F FILE)
#   gh issue close <n> [-R repo] [--comment|-c TEXT]
#   gh issue create [-R repo] --title T --body B [--label L]...   prints the new issue's URL;
#                         numbers continue after the highest issue; id is 1000 + number
#   gh api repos/<o>/<r>/issues/<n>/sub_issues                    the plan's sub-issues (sub_issues-<n>.json,
#                         a list of numbers); POST --method with -F sub_issue_id=<id> adds one, failing
#                         like GitHub when the child already has a parent (parent-<child>) unless
#                         -F replace_parent=true
#   gh api --method POST repos/<o>/<r>/issues/<n>/dependencies/blocked_by -F issue_id=<id>
#   gh api --method DELETE repos/<o>/<r>/issues/<n>/dependencies/blocked_by/<id>
#   gh issue edit <n> --add-label L / --remove-label L (also with a body)
# Anything else fails with exit 1. Needs jq.

set -euo pipefail
: "${FAKE_GH_DIR:?set FAKE_GH_DIR to the fake tracker folder}"
printf '%s\n' "$*" >>"$FAKE_GH_DIR/calls"

issue_file() { printf '%s/issue-%s.json\n' "$FAKE_GH_DIR" "$1"; }
need_issue() { [ -f "$(issue_file "$1")" ] || { echo "gh: issue #$1 not found (HTTP 404)" >&2; exit 1; }; }
set_field() { # n jq-filter [args]
  local f n=$1
  f=$(issue_file "$n")
  shift
  jq "$@" "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# A repo must look like owner/name, as on GitHub.
bad_repo() { echo "gh: expected the \"[HOST/]OWNER/REPO\" format, got \"$1\"" >&2; exit 1; }
check_repo() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || bad_repo "$1"; }

# Common flags after the subcommand: -R, --json, -q/--jq, bodies.
n= json= filter= body= body_set= comments= state=open
parse() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -R|--repo) check_repo "$2"; shift 2 ;;
      --json) json=$2; shift 2 ;;
      -q|--jq) filter=$2; shift 2 ;;
      --body|-b|--comment|-c) body=$2; body_set=1; shift 2 ;;
      --body-file|-F) body=$(cat "$2"); body_set=1; shift 2 ;;
      --comments) comments=1; shift ;;
      --state|-s) state=$2; shift 2 ;;
      --*) shift ;;
      *) [ -n "$n" ] || n=${1#\#}; shift ;;
    esac
  done
}

emit() { # json-object-or-array
  if [ -n "$filter" ]; then printf '%s' "$1" | jq -r "$filter"; else printf '%s\n' "$1"; fi
}

api_method=GET api_fields=
if [ "${1:-}" = api ]; then
  shift
  api_args=("$@")
  path=
  while [ $# -gt 0 ]; do
    case "$1" in
      --method|-X) api_method=$2; shift 2 ;;
      -F|-f|--field|--raw-field) api_fields="$api_fields $2"; shift 2 ;;
      -*) shift ;;
      *) path=$1; shift ;;
    esac
  done
  set -- api "$path"
fi

case "${1:-} ${2:-}" in
  "api "*)
    path=$2
    if [ "$api_method" = DELETE ]; then
      case "$path" in
        */dependencies/blocked_by/*)
          n=${path%/dependencies/blocked_by/*}; n=${n##*/}
          need_issue "$n"
          blocker=
          for f in "$FAKE_GH_DIR"/issue-*.json; do
            [ -f "$f" ] || continue
            b=$(jq -r --argjson id "${path##*/}" 'select((.id // (1000 + .number)) == $id) | .number' "$f")
            [ -z "$b" ] || blocker=$b
          done
          [ -n "$blocker" ] || { echo "gh: blocking issue not found (HTTP 404)" >&2; exit 1; }
          cur='[]'; [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
          printf '%s' "$cur" | jq -c --argjson b "$blocker" 'map(select(. != $b))' >"$FAKE_GH_DIR/blocked_by-$n.json"
          echo '{}' ;;
        *) echo "gh: unsupported api DELETE path: $path" >&2; exit 1 ;;
      esac
      exit 0
    fi
    if [ "$api_method" = POST ]; then
      field() { for kv in $api_fields; do case "$kv" in "$1="*) printf '%s' "${kv#*=}" ;; esac; done; }
      n=${path#repos/*/issues/}; n=${n%%/*}
      need_issue "$n"
      by_id() { for f in "$FAKE_GH_DIR"/issue-*.json; do [ -f "$f" ] && jq -r --argjson id "$1" 'select((.id // (1000 + .number)) == $id) | .number' "$f"; done; }
      case "$path" in
        */sub_issues)
          child=$(by_id "$(field sub_issue_id)")
          [ -n "$child" ] || { echo "gh: sub-issue not found (HTTP 404)" >&2; exit 1; }
          if [ -f "$FAKE_GH_DIR/parent-$child" ] && [ "$(field replace_parent)" != true ]; then
            echo "gh: Parent issue already exists for this sub-issue (HTTP 422)" >&2; exit 1
          fi
          old=$(cat "$FAKE_GH_DIR/parent-$child" 2>/dev/null || true)
          if [ -n "$old" ] && [ -f "$FAKE_GH_DIR/sub_issues-$old.json" ]; then
            jq -c --argjson c "$child" 'map(select(. != $c))' "$FAKE_GH_DIR/sub_issues-$old.json" >"$FAKE_GH_DIR/s.tmp" \
              && mv "$FAKE_GH_DIR/s.tmp" "$FAKE_GH_DIR/sub_issues-$old.json"
          fi
          cur='[]'; [ -f "$FAKE_GH_DIR/sub_issues-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/sub_issues-$n.json")
          printf '%s' "$cur" | jq -c --argjson c "$child" '. + [$c]' >"$FAKE_GH_DIR/sub_issues-$n.json"
          printf '%s' "$n" >"$FAKE_GH_DIR/parent-$child"
          echo '{}' ;;
        */dependencies/blocked_by)
          blocker=$(by_id "$(field issue_id)")
          [ -n "$blocker" ] || { echo "gh: blocking issue not found (HTTP 404)" >&2; exit 1; }
          cur='[]'; [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && cur=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
          printf '%s' "$cur" | jq -e --argjson b "$blocker" 'index($b)' >/dev/null 2>&1 \
            && { echo "gh: already blocked (HTTP 422)" >&2; exit 1; }
          printf '%s' "$cur" | jq -c --argjson b "$blocker" '. + [$b]' >"$FAKE_GH_DIR/blocked_by-$n.json"
          echo '{}' ;;
        *) echo "gh: unsupported api POST path: $path" >&2; exit 1 ;;
      esac
      exit 0
    fi
    r=${path#repos/}; r=${r%%/issues/*}
    case "$path" in repos/*/issues/*) check_repo "$r" ;; esac
    case "$path" in
      repos/*/issues/*/sub_issues)
        n=${path%/sub_issues}; n=${n##*/}
        need_issue "$n"
        list='[]'
        [ -f "$FAKE_GH_DIR/sub_issues-$n.json" ] && list=$(cat "$FAKE_GH_DIR/sub_issues-$n.json")
        for b in $(printf '%s' "$list" | jq -r '.[]'); do jq -c '{number, title, state, labels}' "$(issue_file "$b")"; done | jq -s . ;;
      repos/*/issues/*/dependencies/blocked_by)
        n=${path%/dependencies/blocked_by}; n=${n##*/}
        need_issue "$n"
        list='[]'
        [ -f "$FAKE_GH_DIR/blocked_by-$n.json" ] && list=$(cat "$FAKE_GH_DIR/blocked_by-$n.json")
        for b in $(printf '%s' "$list" | jq -r '.[]'); do
          if [ -f "$(issue_file "$b")" ]; then jq -c '{number, title, state}' "$(issue_file "$b")"
          else jq -cn --argjson b "$b" '{number: $b, state: "open"}'; fi
        done | jq -s . ;;
      repos/*/issues/*)
        n=${path##*/}
        need_issue "$n"
        jq '. + {id: (.id // (1000 + .number))}' "$(issue_file "$n")" ;;
      *) echo "gh: unsupported api path: $path" >&2; exit 1 ;;
    esac ;;
  "issue view")
    shift 2; parse "$@"; need_issue "$n"
    f=$(issue_file "$n")
    if [ -n "$json" ]; then
      emit "$(jq -c --arg fields "$json" --arg c "$(cat "$FAKE_GH_DIR/comments-$n.md" 2>/dev/null || true)" '
        . + {comments: (if $c == "" then [] else [$c | split("\n---\n")[] | {body: .}] end)}
        | with_entries(select(.key as $k | $fields | split(",") | index($k)))' "$f")"
    else
      jq -r '"title:\t\(.title)\nstate:\t\(.state | ascii_upcase)\nnumber:\t\(.number)\n--\n\(.body)"' "$f"
      if [ -n "$comments" ] && [ -f "$FAKE_GH_DIR/comments-$n.md" ]; then
        printf -- '--\n'; cat "$FAKE_GH_DIR/comments-$n.md"
      fi
    fi ;;
  "issue list")
    shift 2; parse "$@"
    # A glob that matches nothing leaves the literal pattern: skip it, so an empty tracker lists [].
    all=$(for f in "$FAKE_GH_DIR"/issue-*.json; do [ -f "$f" ] || continue; cat "$f"; done | jq -s --arg s "$state" \
      'map(select($s == "all" or .state == $s)) | sort_by(.number)')
    if [ -n "$json" ]; then emit "$all"
    else printf '%s' "$all" | jq -r '.[] | "\(.number)\t\(.state | ascii_upcase)\t\(.title)"'; fi ;;
  "issue create")
    shift 2
    title= body= labels='[]'
    while [ $# -gt 0 ]; do
      case "$1" in
        -R|--repo) check_repo "$2"; shift 2 ;;
        --title|-t) title=$2; shift 2 ;;
        --body|-b) body=$2; shift 2 ;;
        --label|-l) labels=$(printf '%s' "$labels" | jq -c --arg l "$2" '. + [{name: $l}]'); shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$title" ] || { echo "gh: a title is required" >&2; exit 1; }
    last=0
    for f in "$FAKE_GH_DIR"/issue-*.json; do
      [ -f "$f" ] || continue
      k=$(jq -r .number "$f"); [ "$k" -le "$last" ] || last=$k
    done
    num=$((last + 1))
    jq -n --argjson n "$num" --arg t "$title" --arg b "$body" --argjson l "$labels" \
      '{number: $n, id: (1000 + $n), title: $t, body: $b, state: "open", labels: $l}' >"$(issue_file "$num")"
    echo "https://github.com/${FAKE_GH_REPO:-local/sample}/issues/$num" ;;
  "issue comment")
    shift 2; parse "$@"; need_issue "$n"
    [ -n "$body_set" ] || { echo "gh: a comment needs --body or --body-file" >&2; exit 1; }
    c="$FAKE_GH_DIR/comments-$n.md"
    [ ! -s "$c" ] || printf '\n---\n' >>"$c"
    printf '%s' "$body" >>"$c" ;;
  "issue edit")
    shift 2; parse "$@"; need_issue "$n"
    [ -z "$body_set" ] || set_field "$n" --arg b "$body" '.body = $b'
    while [ $# -gt 0 ]; do
      case "$1" in
        --add-label) set_field "$n" --arg l "$2" '.labels = ((.labels // []) | map(select(.name != $l)) + [{name: $l}])'; shift 2 ;;
        --remove-label) set_field "$n" --arg l "$2" '.labels = ((.labels // []) | map(select(.name != $l)))'; shift 2 ;;
        *) shift ;;
      esac
    done ;;
  "issue close")
    shift 2; parse "$@"; need_issue "$n"
    if [ -n "$body_set" ]; then
      c="$FAKE_GH_DIR/comments-$n.md"
      [ ! -s "$c" ] || printf '\n---\n' >>"$c"
      printf '%s' "$body" >>"$c"
    fi
    set_field "$n" '.state = "closed"' ;;
  *) echo "gh (fake): unsupported: $*" >&2; exit 1 ;;
esac
